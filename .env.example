# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=events
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/events

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Backend
PORT=3000
APP_URL=http://localhost:8080
MAIL_FROM=U-welcome <noreply@u-welcome.local>
# Часовой пояс для дат в письмах (IANA), например Asia/Bishkek
DISPLAY_TIMEZONE=UTC

# Порты сервисов в docker compose
BACKEND_PORT=3000
FRONTEND_PORT=8080
